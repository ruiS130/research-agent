ANTHROPIC_API_KEY=sk-ant-your-key-here
CHROMA_PERSIST_DIR=./chroma_data
JOBS_DB_PATH=./data/jobs.db

# Cost: min (default) = 1 cheap Haiku call per job; full = original multi-call pipeline
COST_MODE=min
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional overrides (defaults already tight in min mode):
# MAX_GAP_LOOPS=0
# MAX_SUB_QUESTIONS=1
# MAX_SOURCES_PER_QUERY=2
# MAX_SEARCH_RESULTS=3
# SYNTHESIZE_MAX_TOKENS=1024
# Optional USD rates for estimated_usd logs (per 1M tokens):
# ANTHROPIC_INPUT_USD_PER_MTOK=0.80
# ANTHROPIC_OUTPUT_USD_PER_MTOK=4.00
# Haiku 5.5 bills the whole request at 5x when input_tokens exceed this.
# The agent flags that case and includes it in estimated_usd. It does not
# skip or shrink the call.
# HAIKU_LONG_CONTEXT_TOKENS=100000
# HAIKU_LONG_CONTEXT_MULTIPLIER=5
# LOG_LEVEL=INFO

# Access control. Leave APP_API_KEY empty on localhost. Set it before the app
# is reachable on any other address (a deploy, a tunnel, or 0.0.0.0 shared
# beyond this machine). Send it as Authorization: Bearer <key> or X-API-Key.
# APP_API_KEY=
# Research starts allowed per IP in each window (default 10 per 600 seconds).
# RESEARCH_RATE_LIMIT=10
# RESEARCH_RATE_WINDOW_SECONDS=600
# Set when a reverse proxy sets X-Forwarded-For. Otherwise the limit uses the
# socket address, which would be the proxy for every visitor.
# TRUST_PROXY=0

# Search: ddg (default) | tavily | serper
SEARCH_PROVIDER=ddg
# TAVILY_API_KEY=
# SERPER_API_KEY=
