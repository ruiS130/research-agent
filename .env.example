ANTHROPIC_API_KEY=sk-ant-your-key-here
CHROMA_PERSIST_DIR=./chroma_data
JOBS_DB_PATH=./data/jobs.db

# Cost: min (default) = 1 cheap Haiku call per job; full = original multi-call pipeline
COST_MODE=min
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional overrides (defaults already tight in min mode):
# MAX_GAP_LOOPS=0
# MAX_SUB_QUESTIONS=1
# MAX_SOURCES_PER_QUERY=2
# MAX_SEARCH_RESULTS=3
# SYNTHESIZE_MAX_TOKENS=1024
# Optional USD rates for estimated_usd logs (per 1M tokens):
# ANTHROPIC_INPUT_USD_PER_MTOK=0.80
# ANTHROPIC_OUTPUT_USD_PER_MTOK=4.00
# Haiku 5.5 bills the whole request at 5x when input_tokens exceed this.
# The agent flags that case and includes it in estimated_usd. It does not
# skip or shrink the call.
# HAIKU_LONG_CONTEXT_TOKENS=100000
# HAIKU_LONG_CONTEXT_MULTIPLIER=5
# LOG_LEVEL=INFO

# Search: ddg (default) | tavily | serper
SEARCH_PROVIDER=ddg
# TAVILY_API_KEY=
# SERPER_API_KEY=
